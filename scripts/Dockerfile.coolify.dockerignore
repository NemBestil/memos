# This overrides the root .dockerignore to include frontend sources. Coolify
# supplies SOURCE_COMMIT as a build argument; Git metadata is not needed.
/.git/
/build/
/bin/
/tmp/
/memos
/memos.exe
coverage.out
**/node_modules/
**/dist/
**/.pnpm-store/
/.worktrees/
/docs/
/.github/
*.md
**/.env
**/.env.*
/.idea/
/.vscode/
/.claude/
**/.DS_Store

# syntax=docker/dockerfile:1.19

# Build directly from a Git checkout, including the frontend normally built by CI.
FROM --platform=$BUILDPLATFORM node:24-alpine AS frontend
WORKDIR /frontend-build
RUN npm install --global pnpm@11.0.1
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./web/
COPY web/patches ./web/patches
RUN --mount=type=cache,target=/pnpm/store \
    cd web && pnpm install --frozen-lockfile --store-dir=/pnpm/store
COPY web ./web
RUN cd web && pnpm release

FROM --platform=$BUILDPLATFORM golang:1.27.2-alpine AS backend
WORKDIR /backend-build
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY --exclude=web . .
COPY --from=frontend /frontend-build/server/frontend/dist ./server/frontend/dist

# Coolify removes .git before building. Stamp the source commit supplied by Coolify
# and a UTC build-date development version, unless VERSION is explicitly supplied.
ARG TARGETOS TARGETARCH SOURCE_COMMIT VERSION
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    : "${SOURCE_COMMIT:?Enable Source commit availability during build in Coolify}" && \
    printf '%s' "$SOURCE_COMMIT" | grep -Eq '^[0-9a-f]{7,64}$' && \
    build_date="$(date -u +%y.%m.%d | sed 's/\.0\([1-9]\)$/\.\1/')" && \
    build_version="${VERSION:-${build_date}-dev.$(printf '%.7s' "$SOURCE_COMMIT")}" && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -buildvcs=false -trimpath \
      -ldflags="-s -w -X github.com/usememos/memos/internal/version.Version=${build_version} -X github.com/usememos/memos/internal/version.Commit=${SOURCE_COMMIT}" \
      -tags netgo,osusergo -o memos ./cmd/memos

FROM alpine:3.21 AS monolithic
RUN apk add --no-cache tzdata ca-certificates su-exec && \
    addgroup -g 10001 -S nonroot && \
    adduser -u 10001 -S -G nonroot -h /var/opt/memos nonroot && \
    mkdir -p /var/opt/memos /usr/local/memos && \
    chown -R nonroot:nonroot /var/opt/memos
COPY --from=backend /backend-build/memos /usr/local/memos/memos
COPY --chmod=755 scripts/entrypoint.sh /usr/local/memos/entrypoint.sh
USER root
WORKDIR /var/opt/memos
VOLUME /var/opt/memos
ENV TZ="UTC" MEMOS_PORT="5230"
EXPOSE 5230
ENTRYPOINT ["/usr/local/memos/entrypoint.sh", "/usr/local/memos/memos"]
